---
layout: base.njk
title: Predikningar
order: 4
---

<h1>Predikningar</h1>

{% set sermons = collections.predikningar %}

<div id="filesSection">
  {% if sermons and sermons.length > 0 %}
    <table class="file-table">
      <thead>
        <tr>
          <th>Datum</th>
          <th>Titel</th>
          <th>Talare</th>
        </tr>
      </thead>
      <tbody id="filesList">
        {% for sermon in sermons %}
          <tr data-href="{{ sermon.url }}" tabindex="0" role="link">
            <td>{{ sermon.data.date | isoDate }}</td>
            <td>{{ sermon.data.speaker if sermon.data.speaker else "" }}</td>
            <td><b>{{ sermon.data.title if sermon.data.title else "" }}</b></td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <div id="noFilesMessage" class="no-files-message">
      <p>Det finns inga filer tillgängliga.</p>
    </div>
  {% endif %}
</div>
