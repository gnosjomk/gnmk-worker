---
layout: base.njk
title: Hem
---

<div class="hero home-div">
    <section class="content content-center">
        <h1>Välkommen till Gnosjö Missionskyrka!</h1>
        <p> Vi vill erbjuda en öppen och generös gemenskap för alla oavsett bakgrund.<br />
        Vi tror att mötet med Jesus kan göra skillnad i våra liv.</p>
    </section>
</div>

{% if collections.activities | length %}
  <div class="home-div">
    <h2 class="content-center">
      <a class="undecorated-link" href="verksamheter">
        Våra verksamheter
      </a>
    </h2>
    <section class="activities">
      {% for item in collections.activities %}
        <a class="undecorated-link" href="{{item.url}}">
          <section>
              <h3>{{ item.data.title }}</h3>
              <p>{{ item.data.puff }}</p>
              <b>{{ item.data.readmore if item.data.readmore else item.data.title }}&nbsp;&rsaquo;</b>
          </section>
        </a>
      {% endfor %}
    </section>
  </div>
{% endif %}

{% if collections.news | length %}
  <div class="home-div">
    <h2 class="content-center">
      <a class="undecorated-link" href="nyheter">
        Nyheter
      </a>
    </h2>
    <section class="news">
      {% for item in collections.news | limit(5) %}
        <a class="undecorated-link" href="{{item.url}}">
          {% if item.data.img %}
            <img src="/images/{{ item.data.img }}" />
          {% else %}
          {% set fallback = item.url | deterministicDefaultNewsImage %}
            {% if fallback %}
              <img src="/images/{{ fallback }}" />
            {% endif %}
          {% endif %}
          <section>
            <h3>{{ item.data.title }}</h3>
            <p>{{ item.data.date | isoDate }}{% if item.data.time %} {{ item.data.time }}{% endif %}</p>
            <p>{{ item.data.puff }}</p>
          </section>
        </a>
      {% endfor %}
    </section>
  </div>
{% endif %}

<div class="home-div">
  <h2 class="content-center">
    <a class="undecorated-link" href="https://www.instagram.com/gnosjomissionskyrka/" target="_blank" rel="noopener">
      Följ oss på Instagram
    </a>
  </h2>
  <section class="instagram-feed">
    <div class="instagram-placeholder" id="ig-placeholder">
      <p>Klicka för att ladda inlägg från Instagram</p>
      <button type="button" id="ig-load-btn">Visa inlägg</button>
      <p class="instagram-privacy-note">Genom att klicka godkänner du att data skickas till Instagram och Behold.</p>
    </div>
    <div id="ig-widget" hidden>
      <behold-widget feed-id="aeqvm9zFGPD50DbrEsZ6"></behold-widget>
    </div>
  </section>
</div>
<script>
  document.getElementById('ig-load-btn').addEventListener('click', function () {
    var script = document.createElement('script');
    script.src = 'https://w.behold.so/widget.js';
    script.type = 'module';
    document.body.appendChild(script);
    document.getElementById('ig-placeholder').hidden = true;
    document.getElementById('ig-widget').hidden = false;
  });
</script>