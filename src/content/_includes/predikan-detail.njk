---
layout: base.njk
---

<div class="predikan-detail">
  <h1>{{ title }}</h1>

  <p>
    {% if date %}{{ date | isoDate }}{% endif %}
    {% if speaker %} • {{ speaker }}{% endif %}
  </p>

  <audio controls preload="none" style="width: 100%;">
    <source src="/api/file/public/predikningar/ljudfiler/{{ file | uriComponent }}" type="audio/mpeg">
    Din webbläsare stöder inte ljudspelaren.
  </audio>

  <p>
    <a class="download-link" href="/api/file/public/predikningar/ljudfiler/{{ file | uriComponent }}" download>
      Ladda ner ljudfil
    </a>
  </p>

  {% if content %}
    {{ content | safe }}
  {% endif %}

  <p>
    <a class="undecorated-link" href="/predikningar/">Till predikoarkivet</a>
  </p>
</div>
