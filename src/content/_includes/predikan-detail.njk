---
layout: base.njk
---

<div class="predikan-detail">
  <h1>{{ title }}</h1>

  <p>
    {% if date %}{{ date | isoDate }}{% endif %}
    {% if speaker %} • {{ speaker }}{% endif %}
  </p>

  {% set audioUrl = file | fileUrl("public/predikningar/ljudfiler") %}

  <audio controls preload="none">
    <source src="{{ audioUrl }}" type="audio/mpeg">
    Din webbläsare stöder inte ljudspelaren.
  </audio>

  <div>
    <a href="{{ audioUrl }}" download>
      <b>Ladda ner ljudfil &rsaquo;</b>
    </a>
  </div>

  {% if content %}
    {{ content | safe }}
  {% endif %}

  <div>
    <a href="/predikningar/" class="undecorated-link">
      <b>Till predikoarkivet &rsaquo;</b>
    </a>
  </div>
</div>
