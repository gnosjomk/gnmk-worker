---
layout: base.njk
---

{% set pdfUrl = file | fileUrl("public/utsikt/pdfer") %}

<div class="utsikt-layout">
  <section class="utsikt-reader">
    <h1>{{ title }}</h1>
    <iframe
      class="utsikt-pdf-frame"
      title="PDF-läsare: {{ title }}"
      loading="lazy"
      src="{{ pdfUrl }}"
    ></iframe>
  </section>

  <aside class="utsikt-info">
    <div class="info-section">
      <a href="{{ pdfUrl }}" download>
        <b>Ladda ner PDF &rsaquo;</b>
      </a>
    </div>

    <div class="info-section">
      <a href="/utsikt/" class="undecorated-link">
        <b>Till Utsikt-arkivet &rsaquo;</b>
      </a>
    </div>

    {% if content %}
      <div class="info-section">
        {{ content | safe }}
      </div>
    {% endif %}
  </aside>
</div>
